# Alpaca (paper by default). Leave blank to use local simulation broker.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# LIVE trading is blocked unless BOTH are true/set deliberately.
ENABLE_LIVE_TRADING=false
TRADING_MODE=PAPER

# Optional AI analysis (not required for the paper vertical slice)
OPENAI_API_KEY=

# API
PORT=8787
HOST=0.0.0.0

# Risk controls
RISK_MAX_POSITION_PCT=0.05
RISK_MAX_EXPOSURE_PCT=0.4
RISK_MAX_ORDER_NOTIONAL=5000
RISK_MAX_DAILY_LOSS_PCT=0.02
RISK_MIN_CONFIDENCE=0.55
RISK_MAX_OPEN_POSITIONS=8

# Comma-separated scan universe
SCAN_UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,TSLA,AMD
